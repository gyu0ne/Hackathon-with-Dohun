# Absolute host path containing the actual AI-Hub OCR dataset.
AIHUB_OCR_DATA=/data/공공행정문서 OCR

# Existing pretrained recognition weights inside the cloned repository.
OCR_PRETRAINED_MODEL=ocr_training/artifacts/pretrained/korean_PP-OCRv5_mobile_rec_pretrained.pdparams

# Optional existing inference model for baseline comparison. Leave empty to
# avoid any automatic model download during the one-shot training run.
OCR_BASELINE_MODEL_DIR=

# Training defaults.
OCR_EPOCHS=20
OCR_BATCH_SIZE=64
OCR_SAVE_BATCH_STEP=500
